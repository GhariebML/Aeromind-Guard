# ================================================================
# AEROMIND CLIMEGUARD — PHYSICAL AI PLATFORM ENVIRONMENT CONFIG
# ================================================================

# Server & Networking
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# FortyGuard Environmental Intelligence Provider
# (If left empty, system runs gracefully reporting NOT_CONFIGURED status)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.io/v1
FORTYGUARD_TIMEOUT=10.0
FORTYGUARD_MAX_RETRIES=3

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=sqlite:///./aeromind_climateguard.db
# DATABASE_URL=postgresql://aeromind:aeromind_secure_password@localhost:5432/aeromind_db

# Redis Message Bus / Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# Local AI Copilot (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Computer Vision & Perception Engine
DEFAULT_DETECTOR_MODEL=models/detection/yolov8m.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
DEFAULT_INFERENCE_DEVICE=cpu
# DEFAULT_INFERENCE_DEVICE=cuda:0
USE_SAHI=false

# Risk & Anomaly Detection Tuning
Z_SCORE_THRESHOLD=2.5
RATE_OF_CHANGE_THRESHOLD=4.0
RISK_THRESHOLD_CRITICAL=80.0
RISK_THRESHOLD_HIGH=60.0
RISK_THRESHOLD_MEDIUM=30.0
